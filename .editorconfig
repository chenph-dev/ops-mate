# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go 官方格式（gofmt）用 tab
[*.go]
indent_style = tab
indent_size = 4

# Markdown 里行尾空格是硬换行，不要修剪
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab